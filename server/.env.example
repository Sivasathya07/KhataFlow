APP_NAME=KhataFlow API
ENVIRONMENT=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/khataflow?retryWrites=true&w=majority
MONGODB_DATABASE=khataflow

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-64-char-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ── Voice (Whisper runs locally — no runtime download) ───────
WHISPER_MODEL=base

# ── Groq LLM ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# ── OpenAI fallback (optional) ────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Multi-tenancy & rate limiting ─────────────────────────────
DEFAULT_BUSINESS_ID=00000000-0000-0000-0000-000000000001
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=120

# ── Auth emails ───────────────────────────────────────────────
PASSWORD_RESET_MINUTES=30
VERIFICATION_TOKEN_DAYS=2
PUBLIC_WEB_URL=http://localhost:8080

# ── UPI & WhatsApp payments ───────────────────────────────────
UPI_ID=your-business@upi
BUSINESS_UPI_NAME=Your Business Name
BUSINESS_WHATSAPP=91XXXXXXXXXX

# ── Twilio WhatsApp (optional) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── SMTP (leave blank in dev → devToken returned instead) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
